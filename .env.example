# Firebase web app configuration
# Copy this file to .env and replace the placeholders with values from:
# Firebase Console > Project Settings > General > Your apps > Web app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Google Analytics measurement ID for Firebase Analytics
VITE_FIREBASE_MEASUREMENT_ID=

# OpenAI configuration
# Create an API key at: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Optional: OpenAI model override
# Used by src/services/openaiService.js for distillation and merging.
VITE_OPENAI_MODEL=gpt-4o-mini